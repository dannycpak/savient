{
  "expo": {
    "name": "Sage",
    "slug": "sage",
    "version": "0.1.0",
    "scheme": "sage",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EBE7DD",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#EBE7DD",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.jbstratis.sage",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Sage uses the camera to photograph specimens for your catalog and Visual Checks.",
        "NSPhotoLibraryUsageDescription": "Sage uses your photo library to add specimen photos to your catalog and Visual Checks.",
        "NSPhotoLibraryAddUsageDescription": "Sage saves specimen photos you choose to add to your catalog.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.jbstratis.sage",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#EBE7DD"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sage needs photo access to add specimen images.",
          "cameraPermission": "Sage needs camera access to photograph specimens."
        }
      ],
      "expo-image",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "owner": "REPLACE_WITH_EXPO_OWNER"
  }
}
