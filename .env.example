# Expo public client env — copy to .env and fill in.
# Secrets (Anthropic, Stripe, RevenueCat webhook auth) live ONLY in Edge Function env
# via `supabase secrets set` (see scripts/setup.sh).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys (not secrets). App user id = Supabase auth uid.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_xxx

# Google OAuth (Supabase Auth → Google provider). iOS needs a native client ID for nonce.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Stripe publishable key — PaymentSheet for marketplace (physical goods only).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
