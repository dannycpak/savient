# Expo public client env — copy to .env and fill in.
# Secrets (Anthropic, Stripe, RevenueCat webhook auth) live ONLY in Edge Function env.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys (not secrets). App user id = Supabase auth uid.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_xxx
